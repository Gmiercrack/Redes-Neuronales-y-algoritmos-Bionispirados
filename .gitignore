# Paquetes comprimidos (no se versionan)
*.zip

# Bytecode y cachés de Python
__pycache__/
*.pyc
*.pyo

# Logs
*.log

# Entornos virtuales
.venv/
venv/

# Documentos fuente del enunciado (referencia local)
*.docx
*.pdf

# Material de clase descargado (referencia local, de gran tamaño)
material-clase/

# Esto crea o actualiza el .gitignore ignorando archivos pesados y temporales
@"
.venv/
__pycache__/
*.rar
.ipynb_checkpoints/
parte1/
"@ | Out-File -FilePath .gitignore -Encoding utf8
